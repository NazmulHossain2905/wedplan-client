# App
PORT=3000

# Public URL of this app (used by better-auth)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Backend API (WedPlan server)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Database (auth users, sessions)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Database used by the app
DB_NAME=wedplan

# Comma-separated emails allowed to register as admin. Leave empty so
# sign-ups can only create customer/vendor accounts.
ADMIN_EMAILS=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Image hosting (ImgBB). Server-only — never expose this key to the browser.
# Get a key at https://api.imgbb.com/
IMGBB_API_KEY=your-imgbb-api-key
